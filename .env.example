# Server-side AI key for the free trial API.
# Fill these in Vercel Project Settings -> Environment Variables.
AI_API_KEY=sk-your-server-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Local Vite dev proxy target for /api.
VITE_FREE_API_BASE_URL=https://word-brawl.vercel.app

# Default is 20. Set to 0 for unlimited free trial usage.
FREE_DAILY_LIMIT=20

# Daily quota reset timezone.
FREE_USAGE_TIMEZONE=Asia/Shanghai

# Optional: only allow a specific cross-origin caller.
# Same-origin calls from the deployed frontend work without this.
ALLOWED_ORIGIN=https://word-brawl.vercel.app

# Optional: stable salt for hashing client IPs in quota storage.
USAGE_HASH_SALT=replace-with-random-string

# Vercel Blob read/write token. Add a Blob store to the Vercel project to
# provision this automatically, or paste the token from the store settings.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# Dynamic Pollinations images saved per IP each day. Default is 20; 0 is unlimited.
IMAGE_DAILY_LIMIT=20
IMAGE_USAGE_TIMEZONE=Asia/Shanghai
IMAGE_USAGE_HASH_SALT=replace-with-random-string

# Required by Vercel Cron when calling /api/cleanup-generated-images.
CRON_SECRET=replace-with-a-long-random-string
